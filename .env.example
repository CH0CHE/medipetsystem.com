# PostgreSQL (docker-compose expone estos valores por defecto)
POSTGRES_USER=medipet
POSTGRES_PASSWORD=medipet_dev_password
POSTGRES_DB=medipetsystem
POSTGRES_PORT=5433
DATABASE_URL="postgresql://medipet:medipet_dev_password@localhost:5433/medipetsystem?schema=public"

# Shadow DB usada por Prisma en `migrate dev` (evita chocar con la BD principal)
SHADOW_DATABASE_URL="postgresql://medipet:medipet_dev_password@localhost:5433/medipetsystem_shadow?schema=public"

# JWT / sesiones — generar valores propios en producción, nunca reutilizar estos.
# openssl rand -base64 48
JWT_ACCESS_SECRET="dev-only-change-me-access-secret-please-rotate"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# Cookies
COOKIE_SECURE=false

# Rate limiting de login
LOGIN_MAX_ATTEMPTS_PER_USERNAME=5
LOGIN_LOCK_MINUTES=15
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_IP_WINDOW_MINUTES=15

# Seed: contraseña temporal del Super Admin bootstrap (se imprime una sola vez en consola si se omite)
SUPERADMIN_USERNAME=SUPERADMIN
SUPERADMIN_BOOTSTRAP_PASSWORD=

NODE_ENV=development
